# Blank preserves the existing local Vite /api proxy.
VITE_API_URL=
# Hosted build: VITE_API_URL=https://api.example.com
# Custom domains use the root asset path. This app is deployed at /.

# Must match backend TENANT_BASE_DOMAIN. Tenant hosts proxy /api on the same origin.
VITE_TENANT_BASE_DOMAIN=ivepos.me

# Canonical public marketing origin; must match the deployed public hostname.
VITE_PUBLIC_SITE_URL=https://ivepos.me
